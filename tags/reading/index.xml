.bsml-status-ongoing  .bsml-progress-fill { background: #2196f3; }
.bsml-status-dropped  .bsml-progress-fill { background: #9e9e9e; }
.bsml-status-paused   .bsml-progress-fill { background: #ff9800; }

 
.bsml-duration-badge {
  margin-top: 5px;
  text-align: center;
  font-size: 0.58rem;
  color: var(--bsml-badge-c);
  white-space: nowrap;
  letter-spacing: 0.03em;
}

 

.bsml-tooltip {
  position: absolute;
  bottom: calc(100% + 16px);
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  width: 234px;

   
  background: var(--bsml-g-bg);
  backdrop-filter: var(--bsml-g-blur);
  -webkit-backdrop-filter: var(--bsml-g-blur);

   
  border: 1px solid var(--bsml-g-border);
  border-radius: 14px;
  box-shadow:
    var(--bsml-g-shadow),
    inset 0  1px 0 var(--bsml-g-hi),
    inset 0 -1px 0 var(--bsml-g-lo);

  padding: 14px 15px 13px;
  color: var(--bsml-g-text);
  font-size: 0.75rem;
  line-height: 1.55;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.20s ease, transform 0.20s ease;
  white-space: normal;
}

 
.bsml-tooltip::after {
  content: &#39;&#39;;
  position: absolute;
  top: 100%;
  left: clamp(10px,
              calc(50% + var(--bsml-tip-arrow-dx, 0px)),
              calc(100% - 10px));
  transform: translateX(-50%) translateY(-1px);
  width: 14px;
  height: 8px;
  background: var(--bsml-g-arrow);
  border-right:  1px solid var(--bsml-g-arrow-b);
  border-bottom: 1px solid var(--bsml-g-arrow-b);
  clip-path: polygon(0 0, 100% 0, 50% 100%);
}

 
.bsml-book:hover .bsml-tooltip,
.bsml-book:focus-visible .bsml-tooltip,
.bsml-book.bsml-tip-open .bsml-tooltip {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
  pointer-events: auto;
}

 
.bsml-tip-title {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--bsml-g-text);
  margin-bottom: 9px;
  line-height: 1.3;
}
.bsml-tip-row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 3px;
}
.bsml-tip-label {
  color: var(--bsml-g-label);
  flex-shrink: 0;
}
.bsml-tip-value {
  color: var(--bsml-g-value);
  text-align: right;
}

 
.bsml-tip-badge {
  display: inline-block;
  padding: 1px 8px;
  border-radius: 99px;
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: capitalize;
}
.bsml-tip-badge.bsml-status-finished {
  background: var(--bsml-badge-fin-bg);
  color: var(--bsml-badge-fin-fg);
}
.bsml-tip-badge.bsml-status-ongoing {
  background: var(--bsml-badge-ong-bg);
  color: var(--bsml-badge-ong-fg);
}
.bsml-tip-badge.bsml-status-dropped {
  background: var(--bsml-badge-drp-bg);
  color: var(--bsml-badge-drp-fg);
}
.bsml-tip-badge.bsml-status-paused {
  background: var(--bsml-badge-pau-bg);
  color: var(--bsml-badge-pau-fg);
}

 
.bsml-tip-progress-wrap {
  margin: 7px 0 4px;
  height: 4px;
  background: var(--bsml-g-track);
  border-radius: 99px;
  overflow: hidden;
}
.bsml-tip-progress-fill {
  height: 100%;
  border-radius: 99px;
}
.bsml-status-finished .bsml-tip-progress-fill { background: #4caf50; }
.bsml-status-ongoing  .bsml-tip-progress-fill { background: #2196f3; }
.bsml-status-dropped  .bsml-tip-progress-fill { background: #9e9e9e; }
.bsml-status-paused   .bsml-tip-progress-fill { background: #ff9800; }

.bsml-tip-notes {
  margin-top: 9px;
  padding-top: 9px;
  border-top: 1px solid var(--bsml-g-divider);
  color: var(--bsml-g-notes);
  font-style: italic;
  font-size: 0.72rem;
  line-height: 1.55;
}
&lt;/style&gt;


&lt;script&gt;
(function () {
  


  class BSMLParser {
    constructor(src) {
      this.lines = src.split(&#39;\n&#39;);
      this.pos   = 0;
    }

     
    clean(line) {
      
      return line.replace(/\s*#[^&#34;]*$/, &#39;&#39;).trimEnd();
    }

    skipEmpty() {
      while (this.pos &lt; this.lines.length) {
        const t = this.lines[this.pos].trim();
        if (t === &#39;&#39; || t.startsWith(&#39;#&#39;)) { this.pos++; }
        else break;
      }
    }

    unquote(s) {
      s = s.trim().replace(/[,;]\s*$/, &#39;&#39;);    
      if (s.length &gt;= 2 &amp;&amp; s[0] === &#39;&#34;&#39; &amp;&amp; s[s.length - 1] === &#39;&#34;&#39;) {
        return s.slice(1, -1);
      }
      return s;
    }

    parse() {
      const shelf = { title: &#39;&#39;, books: [] };
      while (this.pos &lt; this.lines.length) {
        this.skipEmpty();
        if (this.pos &gt;= this.lines.length) break;

        const line = this.clean(this.lines[this.pos]).trim();

        if (line.toLowerCase().startsWith(&#39;shelf &#39;)) {
          shelf.title = this.unquote(line.slice(6).trim());
          this.pos++;
        } else if (line.toLowerCase().startsWith(&#39;book &#39;)) {
          const book = this.parseBook(line);
          if (book) shelf.books.push(book);
        } else {
          this.pos++;
        }
      }
      return shelf;
    }

    parseBook(header) {
       
      const m = header.match(/^book\s+&#34;([^&#34;]+)&#34;\s*\{?\s*$/i);
      const book = {
        title:    m ? m[1] : &#39;Untitled&#39;,
        cover:    &#39;&#39;,
        author:   &#39;&#39;,
        start:    &#39;&#39;,
        status:   &#39;ongoing&#39;,
        end:      &#39;&#39;,
        progress: 0,
        notes:    &#39;&#39;,
      };
      this.pos++;

      while (this.pos &lt; this.lines.length) {
        const raw   = this.lines[this.pos];
        const line  = this.clean(raw).trim();

        if (line === &#39;}&#39;) { this.pos++; break; }
        if (line === &#39;&#39;)  { this.pos++; continue; }

        const ci = line.indexOf(&#39;:&#39;);
        if (ci &gt; 0) {
          const key = line.slice(0, ci).trim().toLowerCase();
          const val = line.slice(ci + 1).trim();
          if (key in book) book[key] = this.coerce(key, this.unquote(val));
        }
        this.pos++;
      }
      return book;
    }

    coerce(key, val) {
      if (key === &#39;progress&#39;) return Math.min(100, Math.max(0, parseInt(val) || 0));
      return val;
    }
  }

   

  function daysBetween(a, b) {
    return Math.round((b - a) / 86400000);
  }

  function duration(book) {
    if (!book.start) return null;
    const start = new Date(book.start);
    if (isNaN(start)) return null;
    const end = (book.status === &#39;finished&#39; &amp;&amp; book.end)
      ? new Date(book.end)
      : new Date();
    if (isNaN(end)) return null;

    const days = daysBetween(start, end);
    if (days &lt; 0) return null;
    if (days === 0) return &#39;today&#39;;
    if (days &lt; 7)  return days + &#39;d&#39;;
    if (days &lt; 30) {
      const w = Math.floor(days / 7), d = days % 7;
      return d ? `${w}w ${d}d` : `${w}w`;
    }
     
    const y1 = start.getFullYear(), mo1 = start.getMonth(), d1 = start.getDate();
    const y2 = end.getFullYear(),   mo2 = end.getMonth(),   d2 = end.getDate();
    let months = (y2 - y1) * 12 + (mo2 - mo1);
    let rem    = d2 - d1;
    if (rem &lt; 0) { months--; rem += 30; }
    if (months &lt;= 0) return days + &#39;d&#39;;
    return rem &gt; 0 ? `${months}mo ${rem}d` : `${months}mo`;
  }

  function fmtDate(d) {
    if (!d) return &#39;&#39;;
    const dt = new Date(d);
    if (isNaN(dt)) return d;
    return dt.toLocaleDateString(&#39;en&#39;, { year: &#39;numeric&#39;, month: &#39;short&#39;, day: &#39;numeric&#39; });
  }

   

  function esc(s) {
    return String(s)
      .replace(/&amp;/g, &#39;&amp;amp;&#39;)
      .replace(/&lt;/g, &#39;&amp;lt;&#39;)
      .replace(/&gt;/g, &#39;&amp;gt;&#39;)
      .replace(/&#34;/g, &#39;&amp;quot;&#39;);
  }

  function buildBook(book) {
    const dur    = duration(book);
    const status = book.status || &#39;ongoing&#39;;
    const statusCls = &#39;bsml-status-&#39; + esc(status);

     
    const pct = book.progress;

     
    const rows = [];
    if (book.author) rows.push([&#39;Author&#39;,   esc(book.author)]);
    if (book.start)  rows.push([&#39;Started&#39;,  fmtDate(book.start)]);
    rows.push([&#39;Status&#39;, `&lt;span class=&#34;bsml-tip-badge ${statusCls}&#34;&gt;${esc(status)}&lt;/span&gt;`]);
    if (book.status === &#39;finished&#39; &amp;&amp; book.end) rows.push([&#39;Finished&#39;, fmtDate(book.end)]);
    if (dur)         rows.push([&#39;Reading&#39;,  esc(dur)]);
    rows.push([&#39;Progress&#39;, `${pct}%`]);

    const rowsHTML = rows.map(([l, v]) =&gt;
      `&lt;div class=&#34;bsml-tip-row&#34;&gt;
         &lt;span class=&#34;bsml-tip-label&#34;&gt;${l}&lt;/span&gt;
         &lt;span class=&#34;bsml-tip-value&#34;&gt;${v}&lt;/span&gt;
       &lt;/div&gt;`
    ).join(&#39;&#39;);

    const notesHTML = book.notes
      ? `&lt;div class=&#34;bsml-tip-notes&#34;&gt;${esc(book.notes)}&lt;/div&gt;` : &#39;&#39;;

    return `
&lt;div class=&#34;bsml-book ${statusCls}&#34; tabindex=&#34;0&#34; role=&#34;button&#34;
     aria-label=&#34;${esc(book.title)}&#34; aria-haspopup=&#34;true&#34;&gt;
  &lt;div class=&#34;bsml-cover-wrap&#34;&gt;
    &lt;img class=&#34;bsml-cover-img&#34;
         src=&#34;${esc(book.cover)}&#34;
         alt=&#34;${esc(book.title)}&#34;
         loading=&#34;lazy&#34;
         onerror=&#34;this.style.display=&#39;none&#39;;this.nextElementSibling.style.display=&#39;flex&#39;&#34;&gt;
    &lt;div class=&#34;bsml-cover-fallback&#34;&gt;${esc(book.title)}&lt;/div&gt;
    &lt;div class=&#34;bsml-progress-track&#34;&gt;
      &lt;div class=&#34;bsml-progress-fill&#34; style=&#34;width:${pct}%&#34;&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  ${dur ? `&lt;div class=&#34;bsml-duration-badge&#34;&gt;${esc(dur)}&lt;/div&gt;` : &#39;&#39;}

  &lt;div class=&#34;bsml-tooltip&#34; role=&#34;tooltip&#34;&gt;
    &lt;div class=&#34;bsml-tip-title&#34;&gt;${esc(book.title)}&lt;/div&gt;
    ${rowsHTML}
    &lt;div class=&#34;bsml-tip-progress-wrap&#34;&gt;
      &lt;div class=&#34;bsml-tip-progress-fill&#34; style=&#34;width:${pct}%&#34;&gt;&lt;/div&gt;
    &lt;/div&gt;
    ${notesHTML}
  &lt;/div&gt;
&lt;/div&gt;`;
  }

  function render(rootId) {
    const root    = document.getElementById(rootId);
    const srcEl   = document.getElementById(rootId + &#39;-data&#39;);
    if (!root || !srcEl) return;

    const parser = new BSMLParser(srcEl.textContent);
    const shelf  = parser.parse();

    const titleHTML = shelf.title
      ? `&lt;div class=&#34;bsml-shelf-title&#34;&gt;${esc(shelf.title)}&lt;/div&gt;` : &#39;&#39;;

    const booksHTML = shelf.books.map(buildBook).join(&#39;\n&#39;);

    root.innerHTML = `
      ${titleHTML}
      &lt;div class=&#34;bsml-shelf&#34;&gt;
        &lt;div class=&#34;bsml-books-row&#34;&gt;${booksHTML}&lt;/div&gt;
        &lt;div class=&#34;bsml-plank&#34;&gt;&lt;/div&gt;
      &lt;/div&gt;`;

    

    function clampTooltip(bookEl) {
      const tip = bookEl.querySelector(&#39;.bsml-tooltip&#39;);
      if (!tip) return;

       
      tip.style.removeProperty(&#39;left&#39;);
      tip.style.removeProperty(&#39;--bsml-tip-arrow-dx&#39;);

       
      const tipRect = tip.getBoundingClientRect();
      const vw      = window.innerWidth || document.documentElement.clientWidth;
      const PAD     = 12;    

      let overflow = 0;
      if      (tipRect.left  &lt; PAD)       overflow = tipRect.left  - PAD;         
      else if (tipRect.right &gt; vw - PAD)  overflow = tipRect.right - (vw - PAD);  

      if (overflow !== 0) {
         
        tip.style.left = `calc(50% - ${overflow}px)`;
         
        tip.style.setProperty(&#39;--bsml-tip-arrow-dx&#39;, overflow + &#39;px&#39;);
      }
    }

    function resetTooltip(bookEl) {
      const tip = bookEl.querySelector(&#39;.bsml-tooltip&#39;);
      if (!tip) return;
      tip.style.removeProperty(&#39;left&#39;);
      tip.style.removeProperty(&#39;--bsml-tip-arrow-dx&#39;);
    }

     
    root.querySelectorAll(&#39;.bsml-book&#39;).forEach(el =&gt; {
       
      el.addEventListener(&#39;mouseenter&#39;, () =&gt; clampTooltip(el));
      el.addEventListener(&#39;focus&#39;,      () =&gt; clampTooltip(el));
      el.addEventListener(&#39;mouseleave&#39;, () =&gt; resetTooltip(el));
      el.addEventListener(&#39;blur&#39;,       () =&gt; resetTooltip(el));

       
      el.addEventListener(&#39;click&#39;, e =&gt; {
        const alreadyOpen = el.classList.contains(&#39;bsml-tip-open&#39;);
         
        root.querySelectorAll(&#39;.bsml-tip-open&#39;).forEach(x =&gt; {
          x.classList.remove(&#39;bsml-tip-open&#39;);
          resetTooltip(x);
        });
        if (!alreadyOpen) {
          clampTooltip(el);
          el.classList.add(&#39;bsml-tip-open&#39;);
        }
        e.stopPropagation();
      });

       
      el.addEventListener(&#39;keydown&#39;, e =&gt; {
        if (e.key === &#39;Enter&#39; || e.key === &#39; &#39;) {
          e.preventDefault();
          el.click();
        }
        if (e.key === &#39;Escape&#39;) {
          el.classList.remove(&#39;bsml-tip-open&#39;);
          resetTooltip(el);
        }
      });
    });

     
    document.addEventListener(&#39;click&#39;, () =&gt; {
      root.querySelectorAll(&#39;.bsml-tip-open&#39;).forEach(x =&gt; {
        x.classList.remove(&#39;bsml-tip-open&#39;);
        resetTooltip(x);
      });
    });
  }

   
  if (document.readyState === &#39;loading&#39;) {
    document.addEventListener(&#39;DOMContentLoaded&#39;, () =&gt; render(&#39;bsml-1776752916075383932&#39;));
  } else {
    render(&#39;bsml-1776752916075383932&#39;);
  }
})();
&lt;/script&gt;</description>
